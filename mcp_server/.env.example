# MCP analytics server local configuration.
# Copy to mcp_server/.env for local development. Do NOT commit a real .env file.

# Host-accessible PostgreSQL (matches docker-compose port mapping 5433).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/retail_bi

# Shared secret/claims for verifying the backend-minted MCP context token.
# These MUST match the backend's MCP_JWT_* settings. Placeholders only.
MCP_JWT_SECRET=dev-mcp-shared-secret-change-me-please
MCP_JWT_ALGORITHM=HS256
MCP_JWT_ISSUER=retail-bi-backend
MCP_JWT_AUDIENCE=retail-bi-mcp

# Optional: echo SQL for debugging.
# SQL_ECHO=false
