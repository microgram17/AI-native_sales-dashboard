# Backend local development configuration.
# Copy to backend/.env and adjust as needed. Do NOT commit a real .env file.

# Host-accessible PostgreSQL (matches the docker-compose port mapping 5433).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/retail_bi

# Clearly non-production JWT signing secret.
JWT_SECRET=dev-insecure-secret-do-not-use-in-production
JWT_ALGORITHM=HS256

# Optional. Leave unset to skip issuer/audience validation.
# JWT_ISSUER=retail-bi-dev
# JWT_AUDIENCE=retail-bi-backend

# MCP analytics server (streamable-HTTP). Host default; in docker compose this is
# overridden to http://mcp_server:8000/mcp/.
MCP_SERVER_URL=http://localhost:8001/mcp

# Short-lived MCP context token. MUST match the MCP server's MCP_JWT_* settings.
# Placeholders only; never commit a real secret.
MCP_JWT_SECRET=dev-mcp-shared-secret-change-me-please
MCP_JWT_ALGORITHM=HS256
MCP_JWT_ISSUER=retail-bi-backend
MCP_JWT_AUDIENCE=retail-bi-mcp
MCP_JWT_TTL_SECONDS=180

# OpenAI LLM for the agent (uses gpt-4o-mini by default). Set your own key.
OPENAI_API_KEY=sk-your-non-production-key
OPENAI_MODEL=gpt-4o-mini
